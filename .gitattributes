# Normalize line endings: store text as LF in the repository.
* text=auto

*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.lock  text eol=lf
LICENSE text eol=lf

# Shell hooks must stay LF or the shebang breaks on Windows.
.githooks/** text eol=lf

# Fonts are embedded with include_bytes! and their lengths are asserted in
# theme::fonts. `text=auto` gets this right today only because git's heuristic
# spots the NUL bytes -- pin it, because a mangled font would be a silent
# corruption that only shows up as tofu at runtime.
*.ttf binary
*.otf binary
*.png binary
